# Copy this file to .env and fill in your own values. Never commit .env.
#
# MySQL connection used by the scraper, FastAPI and Alembic migrations.
# Format: mysql+pymysql://<user>:<password>@<host>:<port>/<database>
#
# Note: if the password contains special characters like @ : / # %,
# URL-encode them (e.g. @ -> %40, # -> %23).
DATABASE_URL=mysql+pymysql://root:YOUR_PASSWORD_HERE@localhost:3306/arrt_credentials
